# OpenAI
OPENAI_API_KEY=
OPENAI_ORGANIZATION_KEY=

# Phoenix / Server (production requires DATABASE_URL and SECRET_KEY_BASE)
# Public origin: BASE_URL takes precedence over PHX_HOST; leave both unset
# to use supported platform metadata (see DEPLOYMENT.md).
PORT=
PHX_SERVER=
PHX_HOST=
# Optional comma-separated domain aliases to redirect to the public origin
REDIRECT_HOSTS=
SECRET_KEY_BASE=
APP_REVISION=

# Database
DATABASE_URL=
POOL_SIZE=

# Fly
FLY_APP_NAME=

# Mailer
SENDGRID_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# X (Twitter) OAuth
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CALLBACK_URL=
X_BEARER_TOKEN=

# Twilio Verify
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Oban Web dashboard HTTP Basic Auth (production only)
OBAN_WEB_USERNAME=
OBAN_WEB_PASSWORD=

# Analytics / misc
AMPLITUDE_KEY=
BASE_URL=
FEATURE_FLAGS=

# MCP session store (Redis)
MCP_SESSION_REDIS_URL=
MCP_SESSION_TTL_MS=
MCP_SESSION_REDIS_POOL=
