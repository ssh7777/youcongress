# APX / Phoenix. Replace apx.example with the canonical host you control.
PORT=4000
PHX_SERVER=true
PHX_HOST=apx.example
BASE_URL=https://apx.example
SECRET_KEY_BASE=
APP_REVISION=

# PostgreSQL. Use a managed PostgreSQL connection string in production.
DATABASE_URL=ecto://postgres:postgres@localhost/apx_dev
DATABASE_SSL_VERIFY=true
POOL_SIZE=10

# Optional Fly.io clustering; leave unset on single-node hosting.
FLY_APP_NAME=

# Deployment preview origins (LiveView origin checks only; not a runtime adapter).
VERCEL_URL=
VERCEL_BRANCH_URL=

# Transactional mail. Use an address on a verified sending domain.
SENDGRID_API_KEY=
EMAIL_FROM=
CONTACT_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# Optional development-only demo seed data. Never use on production.
APX_SEED_DEMO=false
APX_SEED_ADMIN_EMAIL=
APX_SEED_ADMIN_PASSWORD=

# AI providers / product integrations
OPENAI_API_KEY=
OPENAI_ORGANIZATION_KEY=
AMPLITUDE_KEY=
PLAUSIBLE_DOMAIN=
FEATURE_FLAGS=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CALLBACK_URL=
X_BEARER_TOKEN=

# Twilio Verify
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Intelligence RSS scheduler. Daily Oban ingestion runs in production by default.
INTELLIGENCE_INGESTION_ENABLED=true

# Oban Web dashboard HTTP Basic Auth (production only)
OBAN_WEB_USERNAME=
OBAN_WEB_PASSWORD=

# MCP session store (Redis, optional)
MCP_SESSION_REDIS_URL=
MCP_SESSION_TTL_MS=7200000
MCP_SESSION_REDIS_POOL=5
