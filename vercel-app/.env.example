# Public deployment metadata.
NEXT_PUBLIC_APP_NAME=APX
NEXT_PUBLIC_APP_URL=https://apx-lake.vercel.app

# Production uses durable shared PostgreSQL for persistent records and guest sessions.
APX_DATABASE_MODE=external
DATABASE_URL=
# Vercel Postgres integrations may inject either variable instead; no need to
# copy their values when DATABASE_URL is already managed by the integration.
# PRISMA_DATABASE_URL=
# POSTGRES_URL=
# TLS verifies peer certificates by default. Disable only for a trusted local DB.
DATABASE_SSL=true

# Optional self-contained read-only mode for local development:
# APX_DATABASE_MODE=embedded
# (Remove DATABASE_URL when using embedded mode.)
