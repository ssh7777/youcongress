# Public deployment metadata.
NEXT_PUBLIC_APP_NAME=APX
NEXT_PUBLIC_APP_URL=https://apx-lake.vercel.app

# Current read-only production mode: real in-process PostgreSQL via PGlite.
# No database account or connection string is required.
APX_DATABASE_MODE=embedded

# Optional external PostgreSQL mode for a future write-enabled deployment.
# Remove APX_DATABASE_MODE and set a pooled connection URL instead.
DATABASE_URL=
# TLS verifies peer certificates by default. Disable only for a trusted local DB.
DATABASE_SSL=true
