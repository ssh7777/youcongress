#!/bin/sh

# Fly's private IPv6 distribution must not be enabled on other hosts.
if [ -n "${FLY_APP_NAME:-}" ] && [ -n "${FLY_PRIVATE_IP:-}" ]; then
  export ERL_AFLAGS="${ERL_AFLAGS:-} -proto_dist inet6_tcp"
  export ECTO_IPV6="true"
  export RELEASE_DISTRIBUTION="name"
  export RELEASE_NODE="${FLY_APP_NAME}@${FLY_PRIVATE_IP}"
  if [ -n "${ERLANG_COOKIE:-}" ]; then
    export RELEASE_COOKIE="${ERLANG_COOKIE}"
  fi
else
  export RELEASE_DISTRIBUTION="none"
fi

