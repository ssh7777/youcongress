<!DOCTYPE html>
<html lang="en" class="[scrollbar-gutter:stable]">
  <head prefix="og: https://ogp.me/ns#">
    <% social_title =
      cond do
        !assigns[:page_title] -> "APX"
        assigns[:skip_page_suffix] -> assigns[:page_title]
        true -> "#{assigns[:page_title]} / APX"
      end %>
    <% social_image = assigns[:page_image] || url(~p"/images/og-default.png") %>
    <% social_image_alt =
      assigns[:page_image_alt] ||
        "APX — sovereign policy analytics and expert consensus" %>
    <% social_image_width = assigns[:page_image_width] || 1200 %>
    <% social_image_height = assigns[:page_image_height] || 630 %>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="theme-color" content="#090D16" />
    <link rel="icon" type="image/svg+xml" href={~p"/favicon.svg"} />
    <link rel="icon" type="image/x-icon" href={~p"/favicon.ico"} />
    <link rel="icon" type="image/png" sizes="32x32" href={~p"/images/favicon-32x32.png"} />
    <link rel="icon" type="image/png" sizes="512x512" href={~p"/images/favicon.png"} />
    <link rel="apple-touch-icon" sizes="180x180" href={~p"/images/apple-touch-icon.png"} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <%= if assigns[:page_title] do %>
      <%= if assigns[:skip_page_suffix] do %>
        <title>{assigns[:page_title]}</title>
        <meta content={social_title} property="og:title" />
      <% else %>
        <.live_title suffix=" / APX">
          {assigns[:page_title]}
        </.live_title>
        <meta content={social_title} property="og:title" />
      <% end %>
    <% else %>
      <title>APX</title>
    <% end %>
    <%= if assigns[:page_description] do %>
      <meta name="description" content={assigns[:page_description]} />
      <meta content={assigns[:page_description]} property="og:description" />
      <meta name="twitter:description" content={assigns[:page_description]} />
    <% end %>
    <%= if assigns[:canonical_url] do %>
      <link rel="canonical" href={assigns[:canonical_url]} />
      <meta property="og:url" content={assigns[:canonical_url]} />
    <% end %>
    <meta property="og:type" content={assigns[:og_type] || "website"} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="APX" />
    <meta property="og:image" content={social_image} />
    <meta property="og:image:url" content={social_image} />
    <meta property="og:image:secure_url" content={social_image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={social_image_width} />
    <meta property="og:image:height" content={social_image_height} />
    <meta property="og:image:alt" content={social_image_alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={social_title} />
    <meta name="twitter:image" content={social_image} />
    <meta name="twitter:image:alt" content={social_image_alt} />
    <%= if assigns[:canonical_url] do %>
      <meta name="twitter:url" content={assigns[:canonical_url]} />
    <% end %>
    <%= if assigns[:noindex] do %>
      <meta name="robots" content="noindex" />
    <% end %>
    <.json_ld :if={assigns[:structured_data]} data={@structured_data} />

    <%!-- Discovery hints for AI assistants/agents: APX exposes an MCP server. --%>
    <link rel="llms" type="text/markdown" href={~p"/llms.txt"} title="APX for AI agents" />
    <meta name="mcp-server" content={url(~p"/mcp")} />

    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static src={~p"/assets/app.js"}>
    </script>
    <%= if analytics_domain = Application.get_env(:apx, :analytics_domain) do %>
      <script defer data-domain={analytics_domain} src="https://plausible.io/js/script.js">
      </script>
    <% end %>
  </head>
  <body class="apx-theme bg-apx-background text-apx-text antialiased">
    {@inner_content}
    <div
      :if={assigns[:current_user]}
      id="cookie-banner"
      class="fixed bottom-4 left-4 right-4 z-50 rounded-lg border border-zinc-200 bg-white p-4 shadow-xl sm:left-auto sm:w-96"
      role="dialog"
      aria-label="Cookie preferences"
      aria-describedby="cookie-banner-description"
      style="display: none;"
    >
      <div>
        <p class="font-semibold text-zinc-900">Your privacy choices</p>
        <p id="cookie-banner-description" class="mt-1 text-sm leading-5 text-zinc-600">
          With your permission, we use optional analytics to understand how APX is used
          and improve the site. We only do this if you accept. <a
            href={~p"/privacy-policy"}
            class="font-medium text-blue-700 underline hover:text-blue-800"
          >Learn more</a>.
        </p>
      </div>
      <div class="mt-3 flex justify-end gap-2">
        <button
          type="button"
          data-cookie-consent="rejected"
          class="rounded-md border border-zinc-300 px-3 py-1.5 text-sm font-semibold text-zinc-700 hover:bg-zinc-50 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2"
        >
          Reject
        </button>
        <button
          type="button"
          data-cookie-consent="accepted"
          class="rounded-md bg-blue-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2"
        >
          Accept
        </button>
      </div>
    </div>
  </body>
</html>
