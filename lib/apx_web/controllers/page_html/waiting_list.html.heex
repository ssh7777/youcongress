<div class="min-h-screen bg-apx-background text-apx-text">
  <header class="mx-auto flex max-w-7xl items-center justify-between border-b border-apx-line px-4 py-4 sm:px-6">
    <.link href={~p"/"} aria-label="APX home">
      <img src={~p"/logo.svg"} alt="APX — Policy Intelligence" class="h-9 w-auto" />
    </.link>
  </header>
  <main class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6">
    <p class="apx-mono-label">APX / Access status</p>
    <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
      You joined the waiting list. Thanks.
    </h1>
    <p class="mt-6 text-lg leading-8 text-apx-muted">
      We'll let you know when access is available for your account. In the meantime, public
      proposals and source-linked intelligence remain open to explore.
    </p>
    <div class="mt-9 flex flex-wrap justify-center gap-4 font-semibold text-apx-cyan">
      <.link href={~p"/explore"} class="underline underline-offset-4">Explore proposals</.link>
      <.link href={~p"/intelligence"} class="underline underline-offset-4">Browse intelligence</.link>
      <.link href={~p"/contact"} class="underline underline-offset-4">Contact APX</.link>
    </div>
  </main>
</div>
